{
  "kind": "collectionType",
  "collectionName": "clever_forms",
  "info": {
    "singularName": "form",
    "pluralName": "forms",
    "displayName": "CleverForm",
    "description": "Form definitions managed by CleverForms"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "description": { "type": "text" },
    "lifecycle": {
      "type": "enumeration",
      "enum": ["active", "archived"],
      "default": "active",
      "required": true
    },
    "requiresAuthentication": { "type": "boolean", "default": false },
    "schemaVersion": { "type": "integer", "default": 1, "min": 1, "required": true },
    "pages": { "type": "json", "required": true },
    "settings": { "type": "json" },
    "confirmation": { "type": "json" },
    "submissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::clever-forms.submission",
      "mappedBy": "form"
    }
  }
}
