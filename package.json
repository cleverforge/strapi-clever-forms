{
  "name": "@cleverforge/strapi-clever-forms",
  "version": "1.0.0-rc.3",
  "description": "Free Strapi 5 form builder with multi-page forms, conditional logic, secure submissions, and a React renderer.",
  "keywords": [
    "strapi",
    "strapi5",
    "plugin",
    "forms",
    "form-builder",
    "cleverforms",
    "cleverforge"
  ],
  "license": "MIT",
  "author": {
    "name": "CleverForge",
    "url": "https://cleverforge.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cleverforge/strapi-clever-forms.git"
  },
  "homepage": "https://github.com/cleverforge/strapi-clever-forms#readme",
  "bugs": {
    "url": "https://github.com/cleverforge/strapi-clever-forms/issues"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "source": "./client/react/index.tsx",
      "import": "./dist/client/react/index.mjs",
      "require": "./dist/client/react/index.js",
      "default": "./dist/client/react/index.js"
    },
    "./core": {
      "source": "./shared/index.ts",
      "import": "./dist/shared/index.mjs",
      "require": "./dist/shared/index.js",
      "default": "./dist/shared/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "verify": "strapi-plugin verify",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:check": "npm pack --dry-run",
    "validate:release": "npm run typecheck && npm test && npm run build && npm run check:bundle-size && npm run verify && npm run verify:package && npm run pack:check && npm run audit:runtime",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate",
    "test:packed": "node scripts/test-packed-install.mjs",
    "validate:marketplace": "npm run validate:release && npm run test:packed",
    "check:bundle-size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "5.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.1.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1",
    "@strapi/design-system": "^2.0.0"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@strapi/design-system": "^2.0.0",
    "styled-components": "^6.1.0"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x"
  },
  "strapi": {
    "kind": "plugin",
    "name": "clever-forms",
    "displayName": "CleverForms",
    "description": "Strapi 5-native forms and submissions by CleverForge"
  },
  "peerDependenciesMeta": {
    "@strapi/design-system": {
      "optional": false
    },
    "styled-components": {
      "optional": false
    }
  }
}
